---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCaseStudies, getWork } from '../../lib/content';

const studies = await getCaseStudies();
const featuredWork = (await getWork()).filter((p) => p.data.featured).slice(0, 3);
---

<Base
  title="Case Studies"
  description="In-depth case studies from Lara Bobel — the brief, the process, and the results behind the work."
>
  <header class="page-head wrap">
    <p class="eyebrow">Case studies</p>
    <h1>The story behind the work</h1>
    <p class="lede">
      A closer look at selected projects — the brief, the process, the decisions along the way, and how it all turned
      out.
    </p>
  </header>

  <section class="wrap body">
    {
      studies.length > 0 ? (
        <ul class="cs-grid">
          {studies.map((study) => (
            <CaseStudyCard study={study} />
          ))}
        </ul>
      ) : (
        <div class="empty">
          <span class="badge">Coming soon</span>
          <h2>Case studies are in the works.</h2>
          <p>
            I’m putting together deeper dives into a few favorite projects. Until they’re ready, here are some places to
            start:
          </p>
          <ul class="starts">
            {featuredWork.map((p) => (
              <li>
                <a class="link" href={`/work/${p.id}`}>
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
          <div class="actions">
            <a class="btn btn-primary" href="/work">
              Browse all work <span aria-hidden="true">→</span>
            </a>
            <a class="btn btn-ghost" href="/contact">
              Ask me about a project
            </a>
          </div>
        </div>
      )
    }
  </section>
</Base>

<style>
  .body {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .empty {
    max-width: 46rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 6px solid var(--orange);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: var(--orange-tint);
    color: var(--orange-deep);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .empty h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .starts {
    margin: 0 0 2rem;
    padding-left: 1.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
