---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCaseStudies } from '../../lib/content';

export const getStaticPaths = (async () => {
  const studies = await getCaseStudies();
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}) satisfies GetStaticPaths;

const { study } = Astro.props;
const { title, client, summary, year, role, disciplines, cover, coverAlt, showCover } = study.data;
const { Content } = await render(study);
const ogImage = cover ? await getImage({ src: cover, width: 1200, format: 'jpg' }) : undefined;
---

<Base title={title} description={summary} image={ogImage?.src}>
  <article class="study">
    <header class="wrap head">
      <a class="arrow-link back" href="/case-studies"><span aria-hidden="true">←</span> All case studies</a>
      <p class="eyebrow">{disciplines.length ? disciplines.join(' · ') : client}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <dl class="facts">
        <div>
          <dt>Client</dt>
          <dd>{client}</dd>
        </div>
        {
          role && (
            <div>
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
          )
        }
        {
          year && (
            <div>
              <dt>Year</dt>
              <dd>{year}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      cover && showCover && (
        <div class="wrap">
          <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[800, 1200, 1800]} sizes="(max-width: 1180px) 100vw, 1100px" loading="eager" />
        </div>
      )
    }

    <div class="wrap">
      <div class="prose body">
        <Content />
      </div>
      <nav class="end" aria-label="More">
        <a class="arrow-link back" href="/case-studies"><span aria-hidden="true">←</span> All case studies</a>
        <a class="arrow-link" href="/work">See the portfolio <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .head {
    padding-block: 2rem clamp(2rem, 5vw, 3rem);
  }

  .head .back {
    display: flex;
    width: fit-content;
    margin-bottom: 2.5rem;
  }

  .head h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 20ch;
  }

  .lede {
    max-width: 42rem;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    color: var(--ink-soft);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.5rem 0 0;
  }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0.15rem 0 0;
  }

  .cover {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .body {
    margin: clamp(2.5rem, 6vw, 4rem) auto clamp(2rem, 5vw, 3rem);
    font-size: 1.2rem;
  }

  .body :global(h2) {
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    margin-top: 2em;
  }

  .body :global(ol) {
    padding-left: 1.4em;
  }

  .body :global(li) {
    margin-bottom: 0.75em;
  }

  .body :global(li::marker) {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--orange-deep);
  }

  .body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 4px solid var(--orange);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .body :global(blockquote p) {
    margin: 0;
  }

  .end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    max-width: 42rem;
    margin: 0 auto clamp(3rem, 8vw, 5rem);
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .body :global(img) {
    border-radius: var(--radius);
    margin-block: 2rem;
  }
</style>
