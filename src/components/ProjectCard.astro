---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
  /** Load eagerly — use for cards visible on first paint. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, client, categories, cover, coverAlt } = project.data;
---

<li class="card" data-categories={categories.join('|')}>
  <a href={`/work/${project.id}`}>
    <div class="thumb">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[320, 640]}
        sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 360px"
        loading={eager ? 'eager' : 'lazy'}
      />
      <span class="view" aria-hidden="true">View project →</span>
    </div>
    <div class="meta">
      <h3>{title}</h3>
      <p>
        <span>{client}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>{categories.join(', ')}</span>
      </p>
    </div>
  </a>
</li>

<style>
  .card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .thumb {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .view {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s,
      transform 0.3s var(--ease);
  }

  .card a:hover .thumb,
  .card a:focus-visible .thumb {
    transform: translateY(-4px);
    border-color: var(--orange);
    box-shadow:
      0 0 0 3px var(--orange-tint),
      0 18px 32px -18px rgb(31 27 24 / 0.4);
  }

  .card a:hover img {
    transform: scale(1.04);
  }

  .card a:hover .view,
  .card a:focus-visible .view {
    opacity: 1;
    transform: none;
  }

  .meta {
    padding-top: 0.9rem;
  }

  h3 {
    font-size: 1.45rem;
    margin: 0 0 0.2rem;
    transition: color 0.2s;
  }

  .card a:hover h3 {
    color: var(--orange-deep);
  }

  .meta p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .dot {
    margin-inline: 0.35em;
  }

  .card[hidden] {
    display: none;
  }
</style>
