---
/** Before → after callout, e.g. <Stat before="1–3 weeks" after="A few hours" label="…" /> */
interface Props {
  before: string;
  after: string;
  label: string;
}

const { before, after, label } = Astro.props;
---

<figure class="stat">
  <div class="nums">
    <span class="before"><span class="visually-hidden">Before: </span>{before}</span>
    <span class="arrow" aria-hidden="true">→</span>
    <span class="after"><span class="visually-hidden">After: </span>{after}</span>
  </div>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .stat {
    margin: 2.5rem 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 90% 10%, rgb(240 86 34 / 0.3), transparent 50%),
      var(--ink);
    color: #f3ede6;
    border-radius: var(--radius);
  }

  .nums {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.05;
  }

  .before {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: #8f857b;
    text-decoration: line-through;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
  }

  .arrow {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--orange);
  }

  .after {
    font-size: clamp(2.4rem, 7vw, 4rem);
    color: #fff;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: #cfc6bc;
  }
</style>
