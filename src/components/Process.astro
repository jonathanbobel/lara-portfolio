---
/** Numbered left-to-right flow, e.g. <Process steps={[{ title: 'Source', text: '…' }, …]} /> */
interface Props {
  steps: { title: string; text?: string }[];
  label?: string;
}

const { steps, label } = Astro.props;
---

<figure class="process">
  <ol>
    {
      steps.map((step, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <strong>{step.title}</strong>
          {step.text && <span class="text">{step.text}</span>}
        </li>
      ))
    }
  </ol>
  {label && <figcaption>{label}</figcaption>}
</figure>

<style>
  .process {
    margin: 2.5rem 0;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0 !important;
    padding: 0 !important;
    counter-reset: none;
  }

  li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    margin: 0 !important;
    padding: 1rem 1.1rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--orange);
    border-radius: var(--radius);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  li::marker {
    content: none;
  }

  li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -0.7rem;
    top: 1.1rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    font-size: 0.75rem;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--orange-deep);
  }

  strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.15;
  }

  .text {
    color: var(--muted);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    ol {
      grid-template-columns: 1fr;
    }

    li:not(:last-child)::after {
      content: '↓';
      right: auto;
      top: auto;
      left: 1.1rem;
      bottom: -0.75rem;
    }
  }
</style>
